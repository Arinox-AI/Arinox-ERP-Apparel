 "html": "<style>\n.pf{font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#111}\n.pf .hd{background:#111;color:#fff;padding:10px 14px;border-bottom:4px solid #e8590c}\n.pf .hd .co{font-size:15px;font-weight:700;letter-spacing:.03em}.pf .hd .ti{font-size:12px;color:#e8590c;font-weight:700;margin-top:2px}\n.pf table{width:100%;border-collapse:collapse;margin-top:8px}.pf td,.pf th{border:1px solid #bbb;padding:3px 5px;vertical-align:top}\n.pf th{background:#f3f3f3;text-align:left;font-size:10px;text-transform:uppercase}\n.pf .meta td{border:none;padding:2px 6px}.pf .meta b{color:#555;font-weight:600}\n.pf .num{text-align:right}.pf .tot td{font-weight:700;background:#f3f3f3}\n.pf h4{margin:12px 0 2px;font-size:11px;text-transform:uppercase;border-bottom:2px solid #e8590c;padding-bottom:2px}\n.pf .flag{color:#b42318}.pf .sig td{height:42px;border:none;border-top:1px solid #777;width:25%;font-size:10px;color:#555}\n</style>\n<div class=\"pf\" style=\"width:90mm\">\n<div class=\"hd\" style=\"padding:4px 8px\"><div class=\"co\" style=\"font-size:12px\">{{ doc.name }}</div></div>\n<table>\n<tr><th>{{ _(\"Style\") }}</th><td colspan=\"3\">{{ frappe.db.get_value(\"Production Card\", doc.production_card, \"style_no\") }}</td></tr>\n<tr><th>{{ _(\"Colour\") }}</th><td>{{ doc.colour }}</td><th>{{ _(\"Size\") }}</th><td style=\"font-size:16px;font-weight:700\">{{ doc.size }}</td></tr>\n<tr><th>{{ _(\"Bundle\") }}</th><td style=\"font-size:16px;font-weight:700\">{{ doc.bundle_no }}</td><th>{{ _(\"Qty\") }}</th><td style=\"font-size:16px;font-weight:700\">{{ doc.qty }}{% if doc.is_short %} *{% endif %}</td></tr>\n<tr><th>{{ _(\"Plies\") }}</th><td>{{ doc.ply_from }} &ndash; {{ doc.ply_to }}</td><th>{{ _(\"Body\") }}</th><td>{{ doc.body_no }}</td></tr>\n<tr><th>{{ _(\"Component\") }}</th><td>{{ doc.component }}</td><th>{{ _(\"Shade\") }}</th><td>{{ doc.shade_band or \"\" }}</td></tr>\n<tr><th>{{ _(\"Cut\") }}</th><td colspan=\"3\">{{ doc.lay_report }} &middot; {{ doc.purpose